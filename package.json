{
  "name": "react-native-expo-zustand-boilerplate",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prepare": "husky install",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint": "node ./src/scripts/terminal/lint.mjs",
    "format": "node ./src/scripts/terminal/prettier.mjs",
    "push": "node ./src/scripts/terminal/push.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "7.9.0",
    "axios": "1.13.2",
    "expo": "^54.0.31",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "i18next": "25.7.3",
    "react": "19.1.0",
    "react-i18next": "16.5.1",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@commitlint/cli": "20.3.0",
    "@commitlint/config-conventional": "20.3.0",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-preset-expo": "^54.0.9",
    "eslint": "9.39.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-native": "5.0.0",
    "husky": "9.1.7",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  },
  "private": true
}