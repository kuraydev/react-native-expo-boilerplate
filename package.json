{
  "name": "react-native-expo-boilerplate",
  "main": "expo-router/entry",
  "version": "5.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint-config-expo": "^57.0.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky",
    "bootstrap": "node scripts/bootstrap.mjs",
    "setup:eas": "bash scripts/setup-eas.sh",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "update:dev": "npx eas-cli@latest update --channel development --non-interactive",
    "update:preview": "npx eas-cli@latest update --channel preview --non-interactive",
    "update:prod": "npx eas-cli@latest update --channel production --non-interactive",
    "e2e": "maestro test .maestro/smoke.yaml"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "resolver": "react-native-worklets/jest/resolver.js"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}