{
  "name": "react-native-expo-zustand-boilerplate",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prepare": "husky",
    "lint": "node ./src/scripts/terminal/lint.mjs",
    "lint:check": "eslint app/ src/ --max-warnings=0",
    "format": "node ./src/scripts/terminal/prettier.mjs",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx,json}\"",
    "push": "node ./src/scripts/terminal/push.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "1.13.2",
    "expo": "^55.0.8",
    "expo-constants": "~55.0.9",
    "expo-linking": "~55.0.8",
    "expo-router": "~55.0.7",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "i18next": "25.7.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "16.5.1",
    "react-native": "0.83.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.2",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@commitlint/cli": "20.3.0",
    "@commitlint/config-conventional": "20.3.0",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "babel-preset-expo": "~55.0.8",
    "eslint": "9.39.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-native": "5.0.0",
    "husky": "9.1.7",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  },
  "private": true
}
